# dataset — fetched, licensed CC BY-NC-SA, never committed
data/
*.zip
*.tar.xz

# artifacts
runs/
# ...except the calibration reports: a few KB each, they ARE the published
# numbers, and scripts/make_control_figure.py rebuilds the figure from them
# without a GPU or a dataset download.
!runs/*/calibration.json

# serving registry: built locally from runs/ by conformal_seg.registry.
# 42 MB of MobileNetV3 per category, so unlike conformal-rul it is not
# committed; the Dockerfile bakes whatever is present at build time.
models/
!models/.gitkeep
*.pt
*.onnx
*.png
!docs/*.png
!docs/figures/*.png

# python
__pycache__/
*.pyc
.venv/
*.egg-info/
dist/
.pytest_cache/
uv.lock

# os / editors
.vscode/
.idea/
Thumbs.db
.DS_Store

# Terraform (state is local and holds account ids; never committed)
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
